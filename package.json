{
  "name": "nitrobot",
  "version": "1.0.0",
  "description": "An extensible Discord bot built with discord.js",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "deploy": "node --env-file-if-exists=.env scripts/deploy-commands.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "c8 npm test",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage",
    "check": "npm run verify"
  },
  "author": "James Wygocki (Nitrothegreat)",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript": "^7.0.2"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "src/index.js"
    ],
    "check-coverage": true,
    "lines": 90,
    "branches": 90,
    "functions": 90,
    "statements": 90,
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
